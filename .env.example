# SleepWise Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://sleepwise:sleepwise_dev_password@localhost:5432/sleepwise
REDIS_URL=redis://:sleepwise_redis_password@localhost:6379

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_REFRESH_SECRET=change_this_to_another_secure_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# AWS SERVICES
# ============================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# S3 Storage
S3_BUCKET_AUDIO=sleepwise-audio-production
S3_BUCKET_MODELS=sleepwise-ml-models

# SageMaker
SAGEMAKER_ENDPOINT_AUDIO=sleepwise-audio-analysis-v1
SAGEMAKER_ENDPOINT_PREDICTION=sleepwise-prediction-v1

# ============================================
# STRIPE (PAYMENTS)
# ============================================
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Product IDs
STRIPE_PRODUCT_PREMIUM_MONTHLY=price_premium_monthly_id
STRIPE_PRODUCT_PREMIUM_ANNUAL=price_premium_annual_id
STRIPE_PRODUCT_FAMILY_MONTHLY=price_family_monthly_id
STRIPE_PRODUCT_FAMILY_ANNUAL=price_family_annual_id

# ============================================
# SENDGRID (EMAIL)
# ============================================
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=hello@sleepwise.app
SENDGRID_FROM_NAME=SleepWise

# Email Templates
SENDGRID_TEMPLATE_WELCOME=d-welcome_template_id
SENDGRID_TEMPLATE_RESET_PASSWORD=d-reset_password_template_id
SENDGRID_TEMPLATE_SLEEP_REPORT=d-sleep_report_template_id

# ============================================
# TWILIO (SMS/PUSH NOTIFICATIONS)
# ============================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# PUSH NOTIFICATIONS
# ============================================
# Firebase Cloud Messaging
FCM_SERVER_KEY=your_fcm_server_key
FCM_PROJECT_ID=sleepwise-app

# Apple Push Notification Service
APNS_KEY_ID=your_apns_key_id
APNS_TEAM_ID=your_apple_team_id
APNS_BUNDLE_ID=com.sleepwise.app
APNS_KEY_PATH=/path/to/AuthKey.p8
APNS_PRODUCTION=false

# ============================================
# ANALYTICS & MONITORING
# ============================================
# Mixpanel
MIXPANEL_TOKEN=your_mixpanel_token

# Sentry (Error Tracking)
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
SENTRY_ENVIRONMENT=development

# DataDog
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_app_key

# ============================================
# EXTERNAL INTEGRATIONS
# ============================================
# Apple HealthKit
HEALTHKIT_APP_ID=your_healthkit_app_id

# Google Fit
GOOGLE_FIT_CLIENT_ID=your_google_fit_client_id
GOOGLE_FIT_CLIENT_SECRET=your_google_fit_client_secret

# ============================================
# ML/AI SERVICES
# ============================================
# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# Model Configuration
MODEL_AUDIO_VERSION=v1.2.0
MODEL_PREDICTION_VERSION=v1.0.0
MODEL_INFERENCE_TIMEOUT=30000

# ============================================
# SECURITY
# ============================================
# Encryption Keys (use strong random strings)
ENCRYPTION_KEY=32_byte_hex_string_for_data_encryption
ENCRYPTION_ALGORITHM=aes-256-gcm

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006,https://sleepwise.app

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
LOG_LEVEL=debug

# Service Ports
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
SLEEP_SERVICE_PORT=3003
AUDIO_SERVICE_PORT=3004
FAMILY_SERVICE_PORT=3005
CORPORATE_SERVICE_PORT=3006
ANALYTICS_SERVICE_PORT=3007
SUBSCRIPTION_SERVICE_PORT=3008
NOTIFICATION_SERVICE_PORT=3009

# API Gateway
API_GATEWAY_PORT=3000
API_VERSION=v1

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_FAMILY_SHARING=true
FEATURE_CORPORATE_DASHBOARD=true
FEATURE_AI_PREDICTIONS=true
FEATURE_HEALTH_INTEGRATIONS=true
FEATURE_EXPORT_DATA=true

# ============================================
# COMPLIANCE
# ============================================
HIPAA_MODE=true
GDPR_MODE=true
DATA_RETENTION_DAYS=1825

# Audit Logging
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555

# ============================================
# DEVELOPMENT ONLY
# ============================================
# Seed Data
SEED_DATABASE=false
SEED_USERS_COUNT=100

# Debug
DEBUG_SQL=false
DEBUG_REDIS=false
DEBUG_AWS=false

# Mock Services (for testing without external dependencies)
MOCK_STRIPE=false
MOCK_AWS=false
MOCK_SENDGRID=false
MOCK_TWILIO=false
